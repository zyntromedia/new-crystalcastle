# ==============================================
# ZyntroAI CrystalCastle — Environment Template
# Copy to .env and fill in your values
# ==============================================

# === Application ===
APP_NAME=ZyntroAI CrystalCastle
APP_ENV=development
PORT=8000

# === CORS ===
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# === Security ===
ENABLE_SECURITY_HEADERS=true
ENABLE_METRICS=true

# === OAuth (Optional) ===
OAUTH_CLIENT_ID=zyntroai-crystalcastle-dev

# === FIG ===
FIG_ENABLED=true
