🚀 Quick-Start — Fresh Setup (15 Minutes)
 
Step 1 — Bootstrap
 
bash
  
# Create project directory
mkdir -p ~/selfhost && cd ~/selfhost

# Clone or create files
# ├── docker-compose.yml    ← Full stack
# ├── .env                   ← Your secrets (SOPS encrypted)
# ├── .env.example           ← Template
# ├── .sops.yaml             ← SOPS config
# ├── .gitignore             ← Leak protection
# ├── prometheus/prometheus.yml
# ├── loki/local-config.yaml
# ├── promtail/config.yml
# ├── scripts/               ← backup.sh, restore.sh, chaos-test.sh
# └── .github/workflows/     ← ci-cd.yml
 
 
Step 2 — Configure Secrets
 
bash
  
# Copy template
cp .env.example .env
nano .env   # ← Fill ALL values

# Encrypt for Git
sops --encrypt .env > .env.encrypted
# Now .env.encrypted is SAFE to commit!
 
 
Step 3 — One-Command Deploy
 
bash
  
# Create data directories
mkdir -p traefik/acme uptime-kuma wireguard prometheus/data grafana/data loki

# Launch EVERYTHING
docker compose up -d

# Verify all healthy
docker compose ps
 
 
Step 4 — Access Dashboards
 
Service URL Credentials 
📊 Grafana  https://grafana.yourdomain.com   .env  →  AUTH_USER  +  GRAFANA_PASSWORD  
📈 Prometheus  https://prometheus.yourdomain.com  Same Basic Auth 
📋 Uptime Kuma  https://status.yourdomain.com  First-time setup 
🔐 Traefik  https://traefik.yourdomain.com  Same Basic Auth 
🔑 WireGuard  https://yourdomain.com:51821  VPN admin only 
 
 
 
⌨️ Daily Command Cheat Sheet
 
🚀 Stack Management
 
bash
  
# Start / Stop / Restart
docker compose up -d                          # Start ALL
docker compose up -d traefik grafana         # Start specific
docker compose down                           # Stop ALL
docker compose restart                        # Restart ALL
docker compose restart traefik               # Restart one

# Status & Health
docker compose ps                             # Status overview
docker compose logs -f                        # Follow all logs
docker compose logs -f traefik                # Follow one service
docker stats                                  # Live resource usage

# Updates
docker compose pull                           # Update all images
docker compose up -d --force-recreate         # Recreate containers
 
 
🔐 Secrets Management
 
bash
  
# Encrypt / Decrypt
./scripts/secrets.sh encrypt                  # .env → .env.encrypted
./scripts/secrets.sh decrypt                  # .env.encrypted → .env
./scripts/secrets.sh edit                     # Edit encrypted file

# SSH Key Setup
ssh-keygen -t ed25519 -C "email@example.com"  # Generate key
ssh -T git@github.com                          # Test GitHub auth
 
 
💾 Backup & Restore
 
bash
  
# Backup
docker compose exec restic-backup /backup.sh  # Manual backup
restic snapshots                               # List all backups
restic check                                   # Verify integrity

# Restore (CRITICAL — TEST MONTHLY!)
./restore.sh latest                            # Restore latest
./restore.sh abc123def /tmp/restore            # Specific snapshot
 
 
🧪 Chaos & Validation
 
bash
  
# Full self-healing test suite
./scripts/chaos-test.sh

# Manual failure tests
docker kill traefik                           # Crash service → watch restart
docker pause uptime-kuma                      # Pause → unpause
docker network disconnect bridge grafana      # Drop network → reconnect
 
 
📊 Monitoring Queries (Grafana Explore)
 
logql
  
# Loki Logs
{container="traefik"} |= "error"              # Traefik errors
{job=~".+"} |= "alert"                        # All alerts
{container="uptime-kuma"}                    # Uptime Kuma events

# Prometheus Metrics
rate(container_cpu_usage_seconds_total[5m])  # CPU usage per container
container_memory_usage_bytes                  # Memory usage
up{job="cadvisor"} == 0                       # Down services
 
 
 
 
