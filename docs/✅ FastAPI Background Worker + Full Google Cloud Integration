📁 File 1:  gcp_background_worker.py  (Main FastAPI App)
 
python  
from fastapi import FastAPI, Request, HTTPException, Header
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field
from datetime import datetime, timezone
import uuid
import structlog
import os
import json
import subprocess
from typing import Dict, List, Optional, Any
from google.cloud import firestore
from google.cloud import tasks_v2
from google.cloud import storage
from google.cloud import secretmanager

logger = structlog.get_logger()

# ─── Config ───
PROJECT_ID = os.getenv("GCP_PROJECT_ID")
REGION = os.getenv("REGION", "asia-southeast1")
QUEUE_NAME = os.getenv("QUEUE_NAME", "zyntroai-worker-queue")
BUCKET_NAME = os.getenv("BUCKET_NAME")
WORKER_URL = os.getenv("WORKER_URL")

firestore_client = firestore.Client(project=PROJECT_ID)
tasks_client = tasks_v2.CloudTasksClient()
storage_client = storage.Client(project=PROJECT_ID)

QUEUE_PATH = f"projects/{PROJECT_ID}/locations/{REGION}/queues/{QUEUE_NAME}"

# ─── Models ───
class JobStatus(str):
    PENDING = "pending"
    RUNNING = "running"
    COMPLETED = "completed"
    FAILED = "failed"

class SubmitJobRequest(BaseModel):
    job_type: str = Field(..., enum=["knowledge_regen", "skills_refresh", "token_rotate"])
    payload: Dict[str, Any] = {}
    schedule_seconds: int = 0

class JobInfo(BaseModel):
    job_id: str
    job_type: str
    status: str
    progress: int = 0
    message: str = ""
    created_at: str
    started_at: Optional[str] = None
    completed_at: Optional[str] = None
    result: Optional[Dict[str, Any]] = None
    error: Optional[str] = None

# ─── Firestore Helpers ───
def save_job(job: Dict[str, Any]):
    ref = firestore_client.collection("jobs").document(job["job_id"])
    ref.set(job)

def get_job(job_id: str) -> Optional[Dict[str, Any]]:
    ref = firestore_client.collection("jobs").document(job_id)
    doc = ref.get()
    return doc.to_dict() if doc.exists else None

def update_job(job_id: str, updates: Dict[str, Any]):
    ref = firestore_client.collection("jobs").document(job_id)
    ref.update(updates)

# ─── Cloud Tasks Enqueue ───
def enqueue_task(job_id: str, body: Dict[str, Any], schedule_seconds: int = 0):
    payload = json.dumps(body).encode("utf-8")
    task = {
        "http_request": {
            "url": WORKER_URL,
            "http_method": tasks_v2.HttpMethod.POST,
            "headers": {"Content-Type": "application/json"},
            "body": payload,
            "oidc_token": {"service_account_email": f"cloud-run-worker@{PROJECT_ID}.iam.gserviceaccount.com"}
        },
        "schedule_time": {
            "seconds": int(datetime.utcnow().timestamp()) + schedule_seconds
        }
    }
    response = tasks_client.create_task(parent=QUEUE_PATH, task=task)
    logger.info("Task enqueued", job_id=job_id, task_name=response.name)
    return response.name

# ─── Actual Worker Executor (triggered by Cloud Tasks only) ───
def run_auto_generate_knowledge() -> Dict[str, Any]:
    """Call AutoGenerateKnowledge.py + upload artifacts to Cloud Storage"""
    result = subprocess.run(
        ["python", "AutoGenerateKnowledge.py"],
        capture_output=True,
        text=True,
        check=False
    )
    bucket = storage_client.bucket(BUCKET_NAME)
    blob = bucket.blob(f"knowledge/{datetime.utcnow().isoformat()}/report.txt")
    blob.upload_from_string(result.stdout + "\n" + result.stderr)
    return {
        "returncode": result.returncode,
        "stdout": result.stdout[:2000],
        "artifact": f"gs://{BUCKET_NAME}/{blob.name}"
    }

def run_skills_refresh() -> Dict[str, Any]:
    """Scan Skills/ .agents/ validate protected paths"""
    result = subprocess.run(
        ["python", "-c", "import os; print('Scanning Skills & .agents'); print(os.listdir('Skills/') if os.path.exists('Skills/') else [] )"],
        capture_output=True,
        text=True,
        check=False
    )
    return {
        "returncode": result.returncode,
        "stdout": result.stdout[:2000]
    }

def run_token_regen(payload: Dict[str, Any]) -> Dict[str, Any]:
    """Load secrets via Secret Manager then run token_regen.py"""
    secret_name = f"projects/{PROJECT_ID}/secrets/api-secrets/versions/latest"
    secret_client = secretmanager.SecretManagerServiceClient()
    secret = secret_client.access_secret_version(name=secret_name).payload.data.decode("utf-8")
    env = os.environ.copy()
    env["SECRET_JSON"] = secret
    result = subprocess.run(
        ["python", "token_regen.py", json.dumps(payload)],
        capture_output=True,
        text=True,
        env=env,
        check=False
    )
    return {
        "returncode": result.returncode,
        "stdout": result.stdout[:2000]
    }

async def execute_job(job_id: str, job_type: str, payload: Dict[str, Any]):
    update_job(job_id, {
        "status": JobStatus.RUNNING,
        "started_at": datetime.utcnow().replace(tzinfo=timezone.utc).isoformat(),
        "progress": 10,
        "message": "Worker started"
    })
    try:
        output = {}
        if job_type == "knowledge_regen":
            output = run_auto_generate_knowledge()
        elif job_type == "skills_refresh":
            output = run_skills_refresh()
        elif job_type == "token_rotate":
            output = run_token_regen(payload)
        else:
            raise ValueError(f"Unknown job_type {job_type}")

        update_job(job_id, {
            "status": JobStatus.COMPLETED if output.get("returncode", 1) == 0 else JobStatus.FAILED,
            "progress": 100,
            "result": output,
            "completed_at": datetime.utcnow().replace(tzinfo=timezone.utc).isoformat()
        })
        logger.info("Job finished", job_id=job_id)
    except Exception as e:
        logger.exception("Job failed", job_id=job_id)
        update_job(job_id, {
            "status": JobStatus.FAILED,
            "error": str(e),
            "completed_at": datetime.utcnow().replace(tzinfo=timezone.utc).isoformat()
        })

# ─── FastAPI Routes ───
app = FastAPI(
    title="ZyntroAI GCP Background Worker",
    version="1.0.0"
)
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"], # Change to Work Console domain in production
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"]
)

@app.get("/v1/status")
async def health_check():
    return {
        "ok": True,
        "timestamp": datetime.utcnow().replace(tzinfo=timezone.utc).isoformat() + "Z",
        "version": "1.0.0",
        "gcp_project": PROJECT_ID
    }

@app.post("/v1/jobs", status_code=202)
async def submit_job(req: SubmitJobRequest):
    job_id = str(uuid.uuid4())
    job_doc = {
        "job_id": job_id,
        "job_type": req.job_type,
        "status": JobStatus.PENDING,
        "progress": 0,
        "message": "Queued to Cloud Tasks",
        "payload": req.payload,
        "created_at": datetime.utcnow().replace(tzinfo=timezone.utc).isoformat()
    }
    save_job(job_doc)
    enqueue_task(
        job_id=job_id,
        body={"job_id": job_id, "job_type": req.job_type, "payload": req.payload},
        schedule_seconds=req.schedule_seconds
    )
    return {
        "job_id": job_id,
        "status": "queued",
        "url": f"/v1/jobs/{job_id}"
    }

@app.get("/v1/jobs/{job_id}", response_model=JobInfo)
async def get_job_status(job_id: str):
    job = get_job(job_id)
    if not job:
        raise HTTPException(status_code=404, detail="Job not found")
    return job

@app.get("/v1/jobs")
async def list_jobs(limit: int = 20):
    docs = firestore_client.collection("jobs").order_by("created_at", direction=firestore.Query.DESCENDING).limit(limit).stream()
    return [doc.to_dict() for doc in docs]

# Called ONLY by Cloud Tasks
@app.post("/v1/worker/execute")
async def worker_handler(request: Request, authorization: Optional[str] = Header(default=None)):
    body = await request.json()
    job_id = body.get("job_id")
    job_type = body.get("job_type")
    payload = body.get("payload", {})
    if not job_id:
        raise HTTPException(status_code=400, detail="Missing job_id")
    await execute_job(job_id, job_type, payload)
    return {"ok": True, "job_id": job_id}
 
 
