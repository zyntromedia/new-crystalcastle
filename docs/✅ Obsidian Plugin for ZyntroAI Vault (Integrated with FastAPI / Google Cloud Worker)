ts  
import { App, Notice, Plugin, StatusBarItem } from "obsidian";
import { ZyntroApiClient } from "./api";
import { DEFAULT_SETTINGS, ZyntroSettingTab } from "./settings";
import { ZyntroSettings } from "./types";

export default class ZyntroConnector extends Plugin {
  settings: ZyntroSettings = DEFAULT_SETTINGS;
  statusBar?: StatusBarItem;
  pollTimer?: number;

  get client(): ZyntroApiClient {
    return new ZyntroApiClient(this.settings.apiBaseUrl, this.settings.authToken);
  }

  async onload(): Promise<void> {
    await this.loadSettings();
    this.addSettingTab(new ZyntroSettingTab(this.app, this));
    this.statusBar = this.addStatusBarItem();
    this.statusBar.setText("🔄 ZyntroAI: Idle");

    // Command 1: Trigger AutoGenerateKnowledge
    this.addCommand({
      id: "zyntro-regenerate-knowledge",
      name: "ZyntroAI: Regenerate Knowledge Base",
      callback: async () => {
        try {
          const result = await this.client.submitJob({
            job_type: "knowledge_regen",
            payload: { vaultPath: this.app.vault.getRoot().path },
          });
          new Notice(`✅ Knowledge Regen Queued JobID: ${result.job_id}`);
          this.startPolling(result.job_id);
        } catch (err) {
          new Notice(`❌ Failed: ${(err as Error).message}`);
        }
      },
    });

    // Command 2: Refresh Skills & Protected Path Scan
    this.addCommand({
      id: "zyntro-refresh-skills",
      name: "ZyntroAI: Refresh Skills / Scan .agents & Skills",
      callback: async () => {
        try {
          const result = await this.client.submitJob({
            job_type: "skills_refresh",
            payload: {},
          });
          new Notice(`✅ Skills Refresh Queued JobID: ${result.job_id}`);
          this.startPolling(result.job_id);
        } catch (err) {
          new Notice(`❌ Failed: ${(err as Error).message}`);
        }
      },
    });

    // Command 3: View Latest Jobs
    this.addCommand({
      id: "zyntro-list-jobs",
      name: "ZyntroAI: List Recent Jobs",
      callback: async () => {
        try {
          const jobs = await this.client.listJobs();
          const message = jobs.slice(0,5).map(j => `${j.job_id} | ${j.job_type} | ${j.status}`).join("\n");
          new Notice(`📋 Recent Jobs:\n${message}`);
        } catch (err) {
          new Notice(`❌ Failed: ${(err as Error).message}`);
        }
      },
    });
  }

  startPolling(jobId: string): void {
    clearInterval(this.pollTimer);
    this.pollTimer = window.setInterval(async () => {
      try {
        const job = await this.client.getJob(jobId);
        this.statusBar?.setText(`🔄 ${job.job_type}: ${job.status} ${job.progress}%`);
        if (job.status === "completed") {
          new Notice(`✅ Job ${jobId} Completed`);
          clearInterval(this.pollTimer);
          this.statusBar?.setText("✅ ZyntroAI: Completed");
        } else if (job.status === "failed") {
          new Notice(`❌ Job ${jobId} Failed: ${job.error}`);
          clearInterval(this.pollTimer);
          this.statusBar?.setText("❌ ZyntroAI: Failed");
        }
      } catch (err) {
        this.statusBar?.setText("⚠️ ZyntroAI: Poll Error");
      }
    }, this.settings.pollIntervalMs);
  }

  onunload(): void {
    clearInterval(this.pollTimer);
    this.statusBar?.remove();
  }

  async loadSettings(): Promise<void> {
    this.settings = Object.assign({}, DEFAULT_SETTINGS, await this.loadData());
  }

  async saveSettings(): Promise<void> {
    await this.saveData(this.settings);
  }
}
 
 
