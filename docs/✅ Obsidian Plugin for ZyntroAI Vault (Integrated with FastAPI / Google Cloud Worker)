import { JobInfo, SubmitJobRequest } from "./types";

export class ZyntroApiClient {
  constructor(private baseUrl: string, private token: string) {}

  private async fetchJson<T>(path: string, options: RequestInit = {}): Promise<T> {
    const res = await fetch(`${this.baseUrl}${path}`, {
      ...options,
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${this.token}`,
        ...options.headers,
      },
    });
    if (!res.ok) throw new Error(`API Error ${res.status}: ${await res.text()}`);
    return res.json();
  }

  async submitJob(req: SubmitJobRequest): Promise<{ job_id: string; status: string }> {
    return this.fetchJson("/v1/jobs", {
      method: "POST",
      body: JSON.stringify(req),
    });
  }

  async getJob(jobId: string): Promise<JobInfo> {
    return this.fetchJson(`/v1/jobs/${jobId}`);
  }

  async listJobs(): Promise<JobInfo[]> {
    return this.fetchJson("/v1/jobs");
  }

  async healthCheck(): Promise<{ ok: boolean }> {
    return this.fetchJson("/v1/status");
  }
}
 
 
